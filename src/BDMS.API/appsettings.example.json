{
  "ConnectionStrings": {
    "BdmsDb": "Server=<SQL_SERVER>;Database=<DATABASE_NAME>;Trusted_Connection=True;TrustServerCertificate=True;"
  },
  "Jwt": {
    "Issuer": "BDMS.API",
    "Audience": "BDMS.Clients",
    "SigningKey": "<GENERATE_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS>"
  },
  "UseInMemoryDatabase": false,
  "DummyServices": {
    "OtpEnabled": true,
    "FixedOtpCode": "<DEMO_OTP>",
    "PaymentEnabled": true,
    "PaymentAlwaysSucceeds": true
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
